#: ping/ping_common.c:49
#, c-format
msgid ""
"\n"
"Usage\n"
"  ping [options] <destination>\n"
"\n"
"Options:\n"
"  <destination>      DNS name or IP address\n"
"  -3                 RTT precision (do not round up the result time)\n"
"  -a                 use audible ping\n"
"  -A                 use adaptive ping\n"
"  -B                 sticky source address\n"
"  -c <count>         stop after <count> replies\n"
"  -C                 call connect() syscall on socket creation\n"
"  -D                 print timestamps\n"
"  -d                 use SO_DEBUG socket option\n"
"  -e <identifier>    define identifier for ping session, default is random "
"for\n"
"                     SOCK_RAW and kernel defined for SOCK_DGRAM\n"
"                     Imply using SOCK_RAW (for IPv4 only for identifier 0)\n"
"  -f                 flood ping\n"
"  -h                 print help and exit\n"
"  -H                 force reverse DNS name resolution (useful for numeric\n"
"                     destinations or for -f), override -n\n"
"  -I <interface>     either interface name or address\n"
"  -i <interval>      seconds between sending each packet\n"
"  -j                 JSON output (experimental)\n"
"  -L                 suppress loopback of multicast packets\n"
"  -l <preload>       send <preload> number of packages while waiting "
"replies\n"
"  -m <mark>          tag the packets going out\n"
"  -M <pmtud opt>     define path MTU discovery, can be one of <do|dont|want|"
"probe>\n"
"  -n                 no reverse DNS name resolution, override -H\n"
"  -O                 report outstanding replies\n"
"  -p <pattern>       contents of padding byte\n"
"  -q                 quiet output\n"
"  -Q <tclass>        use quality of service <tclass> bits\n"
"  -s <size>          use <size> as number of data bytes to be sent\n"
"  -S <size>          use <size> as SO_SNDBUF socket option value\n"
"  -t <ttl>           define time to live\n"
"  -U                 print user-to-user latency\n"
"  -v                 verbose output\n"
"  -V                 print version and exit\n"
"  -w <deadline>      reply wait <deadline> in seconds\n"
"  -W <timeout>       time to wait for response\n"
"\n"
"IPv4 options:\n"
"  -4                 use IPv4\n"
"  -b                 allow pinging broadcast\n"
"  -R                 record route\n"
"  -T <timestamp>     define timestamp, can be one of <tsonly|tsandaddr|"
"tsprespec>\n"
"\n"
"IPv6 options:\n"
"  -6                 use IPv6\n"
"  -F <flowlabel>     define flow label, default is random\n"
"  -N <nodeinfo opt>  use IPv6 node info query, try <help> as argument\n"
"\n"
"For more details see ping(8).\n"
msgstr ""
"\n"
"Lietošana\n"
"  ping [opcijas] <mērķis>\n"
"\n"
"Opcijas:\n"
"  <mērķis>           DNS nosaukums vai IP adrese\n"
"  -3                 RTT precizitāte (nenoapaļot rezultāta laiku)\n"
"  -a                 izmantot dzirdamu ping\n"
"  -A                 izmantot adaptīvu ping\n"
"  -B                 lipīga avota adrese\n"
"  -c <skaits>        apstāties pēc <skaits> atbildēm\n"
"  -C                 ligzdas izveidē izsaukt sistēmas izsaukumu connect()\n"
"  -D                 izvadīt laikspiedolus\n"
"  -d                 izmantot ligzdas opciju SO_DEBUG\n"
"  -e <identifikators>\n"
"                     definēt ping sesijas identifikatoru; noklusējums ir "
"nejaušs\n"
"                     SOCK_RAW un kodola noteikts SOCK_DGRAM\n"
"                     Nozīmē SOCK_RAW izmantošanu (IPv4 tikai identifikatoram "
"0)\n"
"  -f                 plūdu ping\n"
"  -h                 izvadīt palīdzību un iziet\n"
"  -H                 piespiedu reversā DNS nosaukumu atrisināšana (noder "
"skaitliskiem\n"
"                     mērķiem vai ar -f), aizstāj -n\n"
"  -I <saskarne>      saskarnes nosaukums vai adrese\n"
"  -i <intervāls>     sekundes starp katras paketes nosūtīšanu\n"
"  -j                 JSON izvade (eksperimentāla)\n"
"  -L                 nerādīt multiraides pakešu atgriezenisko cilpu\n"
"  -l <priekšielāde>  gaidot atbildes, nosūtīt <priekšielāde> paketes\n"
"  -m <atzīme>        atzīmēt izejošās paketes\n"
"  -M <pmtud opcija>  definēt ceļa MTU noteikšanu, viens no "
"<do|dont|want|probe>\n"
"  -n                 bez reversās DNS nosaukumu atrisināšanas, aizstāj -H\n"
"  -O                 ziņot par nesaņemtām atbildēm\n"
"  -p <paraugs>       aizpildījuma baita saturs\n"
"  -q                 klusa izvade\n"
"  -Q <tclass>        izmantot pakalpojuma kvalitātes <tclass> bitus\n"
"  -s <izmērs>        izmantot <izmērs> kā nosūtāmo datu baitu skaitu\n"
"  -S <izmērs>        izmantot <izmērs> kā ligzdas opcijas SO_SNDBUF vērtību\n"
"  -t <ttl>           definēt dzīves laiku (TTL)\n"
"  -U                 izvadīt latentumu starp lietotājiem\n"
"  -v                 detalizēta izvade\n"
"  -V                 izvadīt versiju un iziet\n"
"  -w <termiņš>       atbildes gaidīšanas <termiņš> sekundēs\n"
"  -W <noildze>       atbildes gaidīšanas laiks\n"
"\n"
"IPv4 opcijas:\n"
"  -4                 izmantot IPv4\n"
"  -b                 atļaut ping apraides adresei\n"
"  -R                 reģistrēt maršrutu\n"
"  -T <laikspiedols>  definēt laikspiedolu, viens no "
"<tsonly|tsandaddr|tsprespec>\n"
"\n"
"IPv6 opcijas:\n"
"  -6                 izmantot IPv6\n"
"  -F <plūsmas etiķete>\n"
"                     definēt plūsmas etiķeti, noklusējums ir nejauša\n"
"  -N <nodeinfo opcija>\n"
"                     izmantot IPv6 mezgla informācijas vaicājumu, mēģiniet "
"argumentu <help>\n"
"\n"
"Sīkāku informāciju skatiet ping(8).\n"

